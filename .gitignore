# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 运行时产物 ----
logs/
*.log
data/temp/
data/t2i_templates/
dist/

# ---- 本机配置与缓存（含本机路径、密钥，不入库）----
config.json
data/config/*.json
data/config/
data/cmd_config.json
data/*_config.json

# ---- 账号登录态（含游戏登录票 sid，绝不入库）----
# 运行时数据已统一外置到 AstrBot 的 data/plugin_data/<插件名>/，
# 下面几行是旧版本遗留路径，保留忽略以防回滚时误提交
data/accounts.json
data/profile_cache.json
data/accounts_*.json

# ---- 代打注入载荷里的「可现生成」部分（不进仓库）----
# BepInEx/interop 是 Il2CppInterop 从游戏 global-metadata 生成的 127 个互操作程序集，
# 66 MB；BepInEx 首次启动（config 里 UpdateInteropAssemblies = true）会自动重新生成，
# 而且它是游戏侧派生文件，不适合塞进插件仓库 —— 插件市场要求 zip ≤ 16 MB，带上就超标。
# 运行时要真想预置，把文件放回本地 pkg/payload/BepInEx/interop/ 即可，deploy 会照单注入。
pkg/payload/BepInEx/interop/
pkg/payload/BepInEx/cache/
pkg/payload/BepInEx/LogOutput.log
pkg/payload/BepInEx/ErrorLog.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
