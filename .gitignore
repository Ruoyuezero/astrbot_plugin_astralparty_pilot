# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 运行时产物 ----
logs/
*.log
data/temp/
data/t2i_templates/
dist/

# ---- 本机配置与缓存（含本机路径、密钥，不入库）----
config.json
data/config/*.json
data/config/
data/cmd_config.json
data/*_config.json

# ---- 账号登录态（含游戏登录票 sid，绝不入库）----
# 运行时数据已统一外置到 AstrBot 的 data/plugin_data/<插件名>/，
# 下面几行是旧版本遗留路径，保留忽略以防回滚时误提交
data/accounts.json
data/profile_cache.json
data/accounts_*.json

# ---- 代打注入载荷（不进仓库 / 不进插件市场包）----
# 整块 pkg/payload 都改成 GitHub Release 附件（tools/pack_payload.py 打包），
# 插件市场包只带图鉴 / 查号那部分。本地想用 /appa 就把它放在这里（或配 deploy_src），
# 不影响运行，也不会被提交。
pkg/payload/
pkg/payload/BepInEx/cache/
pkg/payload/BepInEx/LogOutput.log
pkg/payload/BepInEx/ErrorLog.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
