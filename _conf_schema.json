{
  "素材与外观": {
    "type": "object",
    "description": "图库位置与出图风格",
    "items": {
      "art_root": {
        "type": "string",
        "default": "",
        "description": "外部美术图库根目录（解包后的 Astral Party 素材）",
        "hint": "填图库的上一级目录，插件会在下面找 Astral Party 子目录。"
      },
      "card_font": {
        "type": "string",
        "default": "simhei",
        "description": "卡面字体",
        "hint": "例如 simhei / msyh"
      },
      "load_mem_limit": {
        "type": "int",
        "default": 0,
        "description": "单张图加载内存上限（MB，0 = 不限制）"
      },
      "emoji_fps": {
        "type": "int",
        "default": 30,
        "description": "表情包动图的帧率"
      },
      "emoji_transparent": {
        "type": "bool",
        "default": true,
        "description": "表情包保留透明背景"
      }
    }
  },
  "查号与登录": {
    "type": "object",
    "description": "查别人档案用的登录票与本地登录端口",
    "items": {
      "alt_sid": {
        "type": "string",
        "default": "",
        "description": "查号用的小号登录票（sid）",
        "hint": "只填一个平时不玩的小号；票在游戏里正用着会自动跳过，避免顶号。发 /appa sid 可以列出本机所有票。"
      },
      "live_client_ver": {
        "type": "string",
        "default": "",
        "description": "客户端版本号",
        "hint": "留空自动探测；探测不准时手填。"
      },
      "login_host": {
        "type": "string",
        "default": "",
        "description": "扫码登录用的地址",
        "hint": "留空自动选择。"
      },
      "login_port": {
        "type": "int",
        "default": 0,
        "description": "扫码登录端口（0 = 自动）"
      },
      "login_lan": {
        "type": "bool",
        "default": true,
        "description": "允许局域网扫码",
        "hint": "手机扫码时需要打开，10 分钟后随会话失效。"
      },
      "admin_qqs": {
        "type": "string",
        "default": "",
        "description": "管理员 QQ（逗号分隔）",
        "hint": "只有这些号能发 /appa 与登录类指令。"
      }
    }
  },
  "陪玩引擎": {
    "type": "object",
    "description": "本地陪玩进程、房间同步与大厅背景",
    "items": {
      "pilot_prefer": {
        "type": "string",
        "default": "eco",
        "description": "出牌偏好",
        "hint": "eco = 保守经济流；aggressive = 激进。"
      },
      "deploy_src": {
        "type": "string",
        "default": "",
        "description": "注入包来源目录",
        "hint": "留空使用插件自带的 payload。"
      },
      "auto_backup": {
        "type": "bool",
        "default": true,
        "description": "注入 / 移除文件时自动备份到 _pilot_backup",
        "hint": "开启：覆盖或撤下的文件先备份（可还原）；关闭：直接覆盖/删除，不留备份、更省空间。"
      },
      "room_watch": {
        "type": "bool",
        "default": false,
        "description": "后台同步房间内全员手牌",
        "hint": "默认关闭：会周期性连服务端，可能影响对局稳定性。"
      },
      "hands_via_api": {
        "type": "bool",
        "default": false,
        "description": "查看局内卡时查一次服务端补全别人手牌",
        "hint": "客户端只同步自己的手牌明细；开启后每条命令查一次，极小概率被判房间错误。"
      },
      "kv_video": {
        "type": "bool",
        "default": true,
        "description": "大厅背景指令发视频",
        "hint": "关掉只发静态壁纸（视频较大，群聊怕卡可以关）。"
      },
      "ffmpeg_path": {
        "type": "string",
        "default": "",
        "description": "ffmpeg 可执行文件路径",
        "hint": "留空则在系统 PATH 中查找 ffmpeg；需要处理大厅背景视频时才用得到。"
      }
    }
  },
  "攻略检索": {
    "type": "object",
    "description": "建议模式的经验检索（/appa off 时生效）",
    "items": {
      "guide_rag": {
        "type": "bool",
        "default": true,
        "description": "按当前局势检索攻略经验"
      },
      "embed_api": {
        "type": "string",
        "default": "",
        "description": "向量检索接口",
        "hint": "留空只用 BM25 关键词检索。"
      },
      "embed_model": {
        "type": "string",
        "default": "bge-m3",
        "description": "向量模型名"
      },
      "embed_key": {
        "type": "string",
        "default": "",
        "description": "向量接口密钥"
      }
    }
  }
}
